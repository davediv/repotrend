---
import ErrorFallback from "../components/ErrorFallback.astro";
import Pagination from "../components/Pagination.astro";
import SearchResultCard from "../components/SearchResultCard.astro";
import Layout from "../layouts/Layout.astro";
import { logError } from "../lib/log";
import { paginate } from "../lib/pagination";
import {
	getSearchLanguages,
	MIN_SEARCH_QUERY_LENGTH,
	parseSearchRequest,
	SEARCH_PAGE_SIZE,
	searchArchive,
} from "../lib/search";
import type { SearchResult } from "../lib/search-types";

export const prerender = false;

const parsed = parseSearchRequest(Astro.url.searchParams);
const { filters } = parsed;
let results: SearchResult[] = [];
let pagination = paginate(0, filters.page, SEARCH_PAGE_SIZE);
let languages: string[] = [];
let hasError = false;

if (parsed.error) {
	Astro.response.status = 400;
	Astro.response.statusText = "Bad Request";
}

try {
	const db = Astro.locals.runtime.env.DB;
	if (parsed.shouldSearch && !parsed.error) {
		const [languageResult, searchResult] = await Promise.all([
			getSearchLanguages(db),
			searchArchive(db, filters),
		]);
		languages = languageResult;
		results = searchResult.results;
		pagination = searchResult.pagination;
	} else {
		languages = await getSearchLanguages(db);
	}
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("search_page_ssr_error", {
		queryLength: filters.query.length,
		hasFilters: Boolean(filters.topic || filters.language || filters.from || filters.to),
	})(error);
}

const hasCriteria = Boolean(
	filters.query || filters.topic || filters.language || filters.from || filters.to,
);
const hasStructuredFilters = Boolean(
	filters.topic || filters.language || filters.from || filters.to,
);
const resultStart = pagination.totalItems > 0 ? pagination.startIndex + 1 : 0;
const resultEnd = pagination.endIndex;
const titleContext = filters.query
	? filters.query
	: filters.topic
		? `#${filters.topic}`
		: filters.language || "Archive";
---

<Layout
	title={hasCriteria ? `Search: ${titleContext} — RepoTrend` : "Search — RepoTrend"}
	description="Search and filter the historical archive of GitHub trending repositories."
>
	<div class="search-page">
		<header class="search-header">
			<p class="search-kicker">GitHub Trending archive</p>
			<h1>Search repositories</h1>
			<p>Search names, descriptions, and topics, or narrow the archive with exact filters.</p>
		</header>

		<form
			class="search-page-form"
			action="/search"
			method="get"
			role="search"
			aria-label="Search trending repos"
			data-analytics-event="search_submit"
			data-analytics-surface="search_page"
		>
			<div class="query-row">
				<label for="search-page-input" class="search-page-icon">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<span class="sr-only">Repository or keyword</span>
				</label>
				<input
					type="search"
					id="search-page-input"
					name="q"
					class="search-page-input"
					placeholder="Repository, owner, description, or topic..."
					autocomplete="off"
					value={filters.query}
				/>
				<button type="submit" class="search-submit">Search</button>
			</div>

			<details class="search-filters" open={hasStructuredFilters}>
				<summary>Filters {hasStructuredFilters && <span>Active</span>}</summary>
				<div class="filter-grid">
					<label>
						<span>Topic</span>
						<input name="topic" value={filters.topic} placeholder="e.g. react" />
					</label>
					<label>
						<span>Language</span>
						<select name="language">
							<option value="">All languages</option>
							{filters.language && !languages.includes(filters.language) && (
								<option value={filters.language} selected>{filters.language}</option>
							)}
							{languages.map((language) => (
								<option value={language} selected={language === filters.language}>{language}</option>
							))}
						</select>
					</label>
					<label>
						<span>From date</span>
						<input type="date" name="from" value={filters.from} />
					</label>
					<label>
						<span>To date</span>
						<input type="date" name="to" value={filters.to} />
					</label>
				</div>
				<div class="filter-actions">
					<button type="submit" class="filter-submit">Apply filters</button>
					{hasCriteria && <a href="/search">Clear search and filters</a>}
				</div>
			</details>
		</form>

		<div
			id="search-results"
			class="search-results"
			aria-live="polite"
			data-analytics-view={!hasError && hasCriteria && results.length === 0 ? "empty_state_view" : undefined}
			data-analytics-surface="search_results"
		>
			{hasError ? (
				<ErrorFallback message="Search is temporarily unavailable. Please try again." />
			) : parsed.error ? (
				<div class="search-empty" role="alert">
					<h2>Check your filters</h2>
					<p>{parsed.error}</p>
				</div>
			) : !hasCriteria ? (
				<div class="search-empty" role="status">
					<h2>Search the archive</h2>
					<p>Enter at least two characters or apply a topic, language, or date filter.</p>
				</div>
			) : filters.query.length > 0 && filters.query.length < MIN_SEARCH_QUERY_LENGTH && !hasStructuredFilters ? (
				<div class="search-empty" role="status">
					<h2>Keep typing</h2>
					<p>Type at least {MIN_SEARCH_QUERY_LENGTH} characters to search.</p>
				</div>
			) : results.length === 0 ? (
				<div class="search-empty" role="status">
					<h2>No repositories found</h2>
					<p>Try a broader keyword, remove a filter, or widen the date range.</p>
				</div>
			) : (
				<>
					<p class="results-count">
						Showing {resultStart}–{resultEnd} of {pagination.totalItems} matching {pagination.totalItems === 1 ? "repository" : "repositories"}.
					</p>
					<ol id="results" class="results-list" aria-label="Search results">
						{results.map((repository, index) => (
							<li><SearchResultCard repository={repository} index={pagination.startIndex + index} /></li>
						))}
					</ol>
					<Pagination pagination={pagination} />
				</>
			)}
		</div>
	</div>
</Layout>

<style>
	.search-page {
		max-width: 56rem;
		margin: 0 auto;
	}

	.search-header {
		margin-bottom: 1.25rem;
	}

	.search-kicker,
	.search-header h1,
	.search-header > p:last-child {
		margin: 0;
	}

	.search-kicker {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.search-header h1 {
		font-size: 1.75rem;
	}

	.search-header > p:last-child {
		margin-top: 0.375rem;
		color: var(--color-text-secondary);
	}

	.search-page-form {
		margin-bottom: 1.5rem;
	}

	.query-row {
		position: relative;
		display: flex;
		gap: 0.5rem;
	}

	.search-page-icon {
		position: absolute;
		top: 12px;
		left: 0.875rem;
		color: var(--color-text-secondary);
		pointer-events: none;
	}

	.search-page-input {
		min-width: 0;
		height: 44px;
		flex: 1;
		padding: 0 1rem 0 2.75rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: inherit;
		font-size: 1rem;
	}

	.search-submit,
	.filter-submit {
		min-height: 44px;
		padding: 0.625rem 1rem;
		border: 1px solid var(--color-accent);
		border-radius: 6px;
		background: var(--color-accent);
		color: var(--color-accent-text);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}

	.search-filters {
		margin-top: 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
	}

	.search-filters summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0.5rem 0.75rem;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}

	.search-filters summary span {
		padding: 0.125rem 0.375rem;
		border-radius: 1rem;
		background: var(--color-bg-secondary);
		color: var(--color-text-secondary);
		font-size: 0.6875rem;
	}

	.filter-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		padding: 0.75rem;
		border-top: 1px solid var(--color-border);
	}

	.filter-grid label {
		display: grid;
		gap: 0.25rem;
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 500;
	}

	.filter-grid input,
	.filter-grid select {
		width: 100%;
		min-height: 42px;
		padding: 0.5rem 0.625rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: 0.875rem;
	}

	.filter-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0 0.75rem 0.75rem;
	}

	.filter-actions a {
		color: var(--color-link);
		font-size: 0.8125rem;
	}

	.results-count {
		margin: 0 0 1rem;
		color: var(--color-text-secondary);
		font-size: 0.875rem;
	}

	.results-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.search-empty {
		display: flex;
		align-items: center;
		flex-direction: column;
		gap: 0.375rem;
		padding: 3rem 1rem;
		color: var(--color-text-secondary);
		text-align: center;
	}

	.search-empty h2,
	.search-empty p {
		margin: 0;
	}

	.search-empty h2 {
		color: var(--color-text);
		font-size: 1.125rem;
	}

	@media (max-width: 640px) {
		.query-row {
			flex-wrap: wrap;
		}

		.search-page-input {
			width: 100%;
			flex-basis: 100%;
		}

		.search-submit {
			width: 100%;
		}

		.filter-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import Layout from "../layouts/Layout.astro";
import DatePicker from "../components/DatePicker.astro";
import Toolbar from "../components/Toolbar.astro";
import RepoCardList from "../components/RepoCardList.astro";
import ErrorFallback from "../components/ErrorFallback.astro";
import { formatDateDisplay, todayUTC } from "../lib/dates";
import { logError } from "../lib/log";
import {
	findLatestAvailableSnapshot,
	getDateRepoCounts,
	getLanguageDistribution,
	getTrendingRepos,
	type DateRepoCount,
	type LanguageDistribution,
	type TrendingRepo,
} from "../lib/trending";
import LanguageChart from "../components/LanguageChart.astro";

export const prerender = false;

const today = todayUTC();
let snapshotDate = today;
let snapshotScrapedAt: string | null = null;
let hasSnapshot = false;
let repos: TrendingRepo[] = [];
let languages: LanguageDistribution[] = [];
let dateCounts: DateRepoCount[] = [];
let hasError = false;

try {
	const db = Astro.locals.runtime.env.DB;
	dateCounts = await getDateRepoCounts(db);
	const latestSnapshot = findLatestAvailableSnapshot(dateCounts, today);

	if (latestSnapshot) {
		hasSnapshot = true;
		snapshotDate = latestSnapshot.date;
		snapshotScrapedAt = latestSnapshot.scraped_at;
		[repos, languages] = await Promise.all([
			getTrendingRepos(db, snapshotDate),
			getLanguageDistribution(db, snapshotDate).catch(() => []),
		]);
	}
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("homepage_ssr_error")(error);
}

const isTodaySnapshot = hasSnapshot && snapshotDate === today;
const snapshotLabel = formatDateDisplay(snapshotDate);
const scrapedAtDate = snapshotScrapedAt ? new Date(snapshotScrapedAt) : null;
const capturedTimeLabel =
	scrapedAtDate && !Number.isNaN(scrapedAtDate.getTime())
		? new Intl.DateTimeFormat("en-US", {
				hour: "numeric",
				minute: "2-digit",
				timeZone: "UTC",
				timeZoneName: "short",
			}).format(scrapedAtDate)
		: null;
const pageTitle = isTodaySnapshot
	? "GitHub Trending Today — RepoTrend"
	: "Latest GitHub Trending Snapshot — RepoTrend";
const pageDescription = isTodaySnapshot
	? "See the unique repositories trending on GitHub today, in the same order as GitHub's daily Trending page."
	: hasSnapshot
		? `See the latest available GitHub Trending snapshot from ${snapshotLabel}, in GitHub's original ranking order.`
		: "Browse the latest available GitHub Trending snapshot and daily archive.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Toolbar>
		<div class="snapshot-heading">
			<p class="snapshot-kicker">Daily GitHub snapshot</p>
			<h1>{isTodaySnapshot ? "Trending today" : "Latest snapshot"}</h1>
			{hasSnapshot && (
				<div class="snapshot-meta">
					<time datetime={snapshotDate}>{snapshotLabel}</time>
					{capturedTimeLabel && snapshotScrapedAt && (
						<time datetime={snapshotScrapedAt}>Captured at {capturedTimeLabel}</time>
					)}
				</div>
			)}
			{hasSnapshot && !isTodaySnapshot && (
				<p class="snapshot-notice" role="status">
					Today's snapshot is not available yet. Showing the latest available snapshot; new
					snapshots are captured daily around 06:00 UTC.
				</p>
			)}
		</div>
		<DatePicker
			selectedDate={snapshotDate}
			viewMode="daily"
			availableDates={dateCounts.length > 0 ? dateCounts.map(({ date }) => date) : undefined}
		/>
	</Toolbar>
	<LanguageChart languages={languages} />
	{hasError ? (
		<ErrorFallback />
		) : (
			<RepoCardList
				repos={repos}
				emptyMessage="No GitHub Trending snapshots are available yet."
			/>
		)}
</Layout>

<style>
	.snapshot-kicker,
	.snapshot-heading h1 {
		margin: 0;
	}

	.snapshot-kicker {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.snapshot-heading h1 {
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.snapshot-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		color: var(--color-text-secondary);
		font-size: 0.875rem;
	}

	.snapshot-notice {
		max-width: 42rem;
		margin-top: 0.375rem;
		color: var(--color-text-secondary);
		font-size: 0.8125rem;
	}
</style>

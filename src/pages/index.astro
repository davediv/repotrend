---
import Layout from "../layouts/Layout.astro";
import DatePicker from "../components/DatePicker.astro";
import Toolbar from "../components/Toolbar.astro";
import RepoCardList from "../components/RepoCardList.astro";
import ErrorFallback from "../components/ErrorFallback.astro";
import { formatDateDisplay, todayUTC } from "../lib/dates";
import { logError } from "../lib/log";
import {
	getDateRepoCounts,
	getLanguageDistribution,
	getTrendingRepos,
	type DateRepoCount,
	type LanguageDistribution,
	type TrendingRepo,
} from "../lib/trending";
import LanguageChart from "../components/LanguageChart.astro";

export const prerender = false;

const today = todayUTC();
const todayLabel = formatDateDisplay(today);
let repos: TrendingRepo[] = [];
let languages: LanguageDistribution[] = [];
let dateCounts: DateRepoCount[] = [];
let hasError = false;

try {
	const db = Astro.locals.runtime.env.DB;
	const [trendingRepos, languageResult, dateCountResult] = await Promise.all([
		getTrendingRepos(db, today),
		getLanguageDistribution(db, today).catch(() => []),
		getDateRepoCounts(db).catch(() => []),
	]);
	repos = trendingRepos;
	languages = languageResult;
	dateCounts = dateCountResult;
} catch (error) {
	hasError = true;
	logError("homepage_ssr_error")(error);
}
---

<Layout
	title="GitHub Trending Today — RepoTrend"
	description="See the unique repositories trending on GitHub today, in the same order as GitHub's daily Trending page."
>
	<Toolbar>
		<div class="today-heading">
			<p>Daily GitHub snapshot</p>
			<h1>Trending today</h1>
			<time datetime={today}>{todayLabel}</time>
		</div>
		<DatePicker
			selectedDate={today}
			viewMode="daily"
			availableDates={dateCounts.length > 0 ? dateCounts.map(({ date }) => date) : undefined}
		/>
	</Toolbar>
	<LanguageChart languages={languages} />
	{hasError ? (
		<ErrorFallback />
	) : (
		<RepoCardList
			repos={repos}
			emptyMessage="Today's GitHub Trending snapshot is not available yet."
		/>
	)}
</Layout>

<style>
	.today-heading p,
	.today-heading h1 {
		margin: 0;
	}

	.today-heading p {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.today-heading h1 {
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.today-heading time {
		color: var(--color-text-secondary);
		font-size: 0.875rem;
	}
</style>

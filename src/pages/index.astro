---
import DailyArchivePage from "../components/DailyArchivePage.astro";
import { createArchiveService } from "../lib/archive-service";
import type { DailyArchiveData } from "../lib/daily-archive";
import { todayUTC } from "../lib/dates";
import { logError } from "../lib/log";

export const prerender = false;

const today = todayUTC();
let data: DailyArchiveData = {
	selectedDate: today,
	snapshot: null,
	repos: [],
	languages: [],
	dateCounts: [],
};
let hasError = false;

try {
	data = await createArchiveService(Astro.locals.runtime.env).getDailyArchive({
		mode: "latest",
		throughDate: today,
	});
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("homepage_ssr_error")(error);
}
---

<DailyArchivePage data={data} today={today} context="latest" hasError={hasError} />

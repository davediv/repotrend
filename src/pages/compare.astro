---
import ComparisonRow from "../components/ComparisonRow.astro";
import ErrorFallback from "../components/ErrorFallback.astro";
import Layout from "../layouts/Layout.astro";
import {
	ArchiveValidationError,
	createArchiveService,
	type ArchiveIndexData,
} from "../lib/archive-service";
import {
	filterComparisonRows,
	parseComparisonView,
	resolveComparisonSelection,
	type ComparisonCounts,
	type ComparisonRow as ComparisonRowData,
	type ComparisonView,
} from "../lib/comparison";
import { formatDateDisplay } from "../lib/dates";
import { logError } from "../lib/log";

export const prerender = false;

const requestedDate1 = Astro.url.searchParams.get("date1")?.trim() ?? "";
const requestedDate2 = Astro.url.searchParams.get("date2")?.trim() ?? "";
const view = parseComparisonView(Astro.url.searchParams.get("view"));
const archive = createArchiveService(Astro.locals.runtime.env);
let archiveIndex: ArchiveIndexData = {
	snapshots: [],
	dates: [],
	earliest: null,
	latest: null,
};
let allRows: ComparisonRowData[] = [];
let counts: ComparisonCounts = { all: 0, both: 0, added: 0, removed: 0 };
let hasError = false;

try {
	archiveIndex = await archive.getArchiveIndex();
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("compare_dates_ssr_error")(error);
}

const availableDates = archiveIndex.dates;
const { date1, date2 } = resolveComparisonSelection(availableDates, requestedDate1, requestedDate2);
let selectionError: string | null = null;

if (!hasError && availableDates.length < 2) {
	selectionError = "At least two captured snapshots are needed before dates can be compared.";
} else if (!hasError) {
	try {
		const comparison = await archive.getComparison(date1, date2, archiveIndex);
		allRows = comparison.rows;
		counts = comparison.counts;
	} catch (error) {
		if (error instanceof ArchiveValidationError) {
			selectionError = error.message;
		} else {
			hasError = true;
			Astro.response.status = 500;
			Astro.response.statusText = "Internal Server Error";
			logError("compare_repositories_ssr_error", { date1, date2 })(error);
		}
	}
}

const rows = filterComparisonRows(allRows, view);
const date1Display = date1 ? formatDateDisplay(date1) : "First date";
const date2Display = date2 ? formatDateDisplay(date2) : "Second date";
const earliestDate = availableDates[0];
const latestDate = availableDates[availableDates.length - 1];

function filterHref(nextView: ComparisonView): string {
	const params = new URLSearchParams({ date1, date2 });
	if (nextView !== "all") params.set("view", nextView);
	return `/compare?${params.toString()}#comparison-results`;
}

const filters: Array<{ value: ComparisonView; label: string; count: number }> = [
	{ value: "all", label: "All", count: counts.all },
	{ value: "both", label: "In both", count: counts.both },
	{ value: "added", label: "Added", count: counts.added },
	{ value: "removed", label: "Removed", count: counts.removed },
];
---

<Layout
	title={selectionError ? "Compare Dates — RepoTrend" : `Compare ${date1Display} and ${date2Display} — RepoTrend`}
	description="Compare aligned GitHub Trending repository appearances, ranks, and star changes across two captured dates."
>
	<div class="compare-page">
		<header class="compare-heading">
			<p>GitHub Trending archive</p>
			<h1>Compare snapshots</h1>
			<span>See what stayed, appeared, disappeared, or moved between two captured dates.</span>
		</header>

		<form class="compare-form" action="/compare" method="get">
			<div class="compare-picker">
				<label for="compare-date1">Earlier snapshot</label>
				<input
					type="date"
					id="compare-date1"
					name="date1"
					value={date1}
					min={earliestDate}
					max={latestDate}
					list="captured-comparison-dates"
					required
				/>
			</div>
			<span class="compare-arrow" aria-hidden="true">→</span>
			<div class="compare-picker">
				<label for="compare-date2">Later snapshot</label>
				<input
					type="date"
					id="compare-date2"
					name="date2"
					value={date2}
					min={earliestDate}
					max={latestDate}
					list="captured-comparison-dates"
					required
				/>
			</div>
			<button type="submit">Compare dates</button>
			<datalist id="captured-comparison-dates">
				{availableDates.map((date) => <option value={date} />)}
			</datalist>
		</form>

		{hasError ? (
			<ErrorFallback message="The comparison could not be loaded. Please try again." />
		) : selectionError ? (
			<div
				class="compare-empty"
				role="alert"
				data-analytics-view="empty_state_view"
				data-analytics-surface="comparison_selection"
			>
				<h2>Comparison unavailable</h2>
				<p>{selectionError}</p>
				<a href="/trending">Browse captured dates</a>
			</div>
		) : (
			<>
				<section
					class="comparison-summary"
					aria-labelledby="comparison-summary-heading"
					data-analytics-view="comparison_complete"
					data-analytics-surface="comparison_results"
				>
					<div>
						<h2 id="comparison-summary-heading">{date1Display} → {date2Display}</h2>
						<p>{counts.all} unique repositories across both snapshots.</p>
					</div>
					<dl>
						<div><dt>In both</dt><dd>{counts.both}</dd></div>
						<div><dt>Added</dt><dd>{counts.added}</dd></div>
						<div><dt>Removed</dt><dd>{counts.removed}</dd></div>
					</dl>
				</section>

				<nav class="comparison-filters" aria-label="Filter comparison results">
					{filters.map((filter) => (
						<a
							href={filterHref(filter.value)}
							aria-current={filter.value === view ? "page" : undefined}
						>
							{filter.label} <span>{filter.count}</span>
						</a>
					))}
				</nav>

				<section id="comparison-results" class="comparison-results" aria-label={`${view === "all" ? "All" : filters.find(({ value }) => value === view)?.label} comparison results`}>
					{rows.length > 0 ? (
						<ol>
							{rows.map((row, index) => (
								<li>
									<ComparisonRow
										row={row}
										index={index}
										firstLabel={date1Display}
										secondLabel={date2Display}
									/>
								</li>
							))}
						</ol>
					) : (
						<div
							class="compare-empty"
							role="status"
							data-analytics-view="empty_state_view"
							data-analytics-surface="comparison_filter"
						>
							<h2>No {filters.find(({ value }) => value === view)?.label.toLowerCase()} repositories</h2>
							<p>This comparison has no repositories in the selected category.</p>
							<a href={filterHref("all")}>Show all comparison results</a>
						</div>
					)}
				</section>
			</>
		)}
	</div>
</Layout>

<style>
	.compare-page {
		max-width: 72rem;
		margin: 0 auto;
	}

	.compare-heading {
		margin-bottom: 1.25rem;
	}

	.compare-heading p,
	.compare-heading h1,
	.compare-heading span {
		margin: 0;
	}

	.compare-heading p {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.compare-heading h1 {
		font-size: 1.75rem;
	}

	.compare-heading span {
		display: block;
		margin-top: 0.375rem;
		color: var(--color-text-secondary);
	}

	.compare-form {
		display: flex;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-bg-secondary);
	}

	.compare-picker {
		display: grid;
		gap: 0.375rem;
	}

	.compare-picker label {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.compare-picker input {
		min-height: 44px;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: 0.875rem;
	}

	.compare-arrow {
		padding-bottom: 0.75rem;
		color: var(--color-text-secondary);
	}

	.compare-form button {
		min-height: 44px;
		padding: 0.625rem 1rem;
		border: 1px solid var(--color-accent);
		border-radius: 6px;
		background: var(--color-accent);
		color: var(--color-accent-text);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}

	.comparison-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: 8px;
	}

	.comparison-summary h2,
	.comparison-summary p,
	.comparison-summary dl,
	.comparison-summary dt,
	.comparison-summary dd {
		margin: 0;
	}

	.comparison-summary h2 {
		font-size: 1.125rem;
	}

	.comparison-summary p,
	.comparison-summary dt {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
	}

	.comparison-summary dl {
		display: flex;
		gap: 1.5rem;
	}

	.comparison-summary dl div {
		display: grid;
		justify-items: center;
	}

	.comparison-summary dd {
		font-size: 1.125rem;
		font-weight: 700;
	}

	.comparison-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.comparison-filters a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 40px;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-text);
		font-size: 0.8125rem;
		text-decoration: none;
	}

	.comparison-filters a[aria-current="page"] {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-accent-text);
	}

	.comparison-filters span {
		font-variant-numeric: tabular-nums;
	}

	.comparison-results ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.compare-empty {
		display: flex;
		align-items: center;
		flex-direction: column;
		gap: 0.5rem;
		padding: 3rem 1rem;
		color: var(--color-text-secondary);
		text-align: center;
	}

	.compare-empty h2,
	.compare-empty p {
		margin: 0;
	}

	.compare-empty h2 {
		color: var(--color-text);
		font-size: 1.125rem;
	}

	.compare-empty a {
		min-height: 44px;
		padding: 0.625rem;
		color: var(--color-link);
	}

	@media (max-width: 640px) {
		.compare-form {
			align-items: stretch;
			flex-direction: column;
		}

		.compare-picker,
		.compare-picker input,
		.compare-form button {
			width: 100%;
		}

		.compare-arrow {
			padding: 0;
			text-align: center;
			transform: rotate(90deg);
		}

		.comparison-summary {
			align-items: flex-start;
			flex-direction: column;
		}

		.comparison-summary dl {
			width: 100%;
			justify-content: space-between;
		}

		.comparison-filters a {
			min-height: 44px;
		}
	}
</style>

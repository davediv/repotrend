---
import Layout from "../../../layouts/Layout.astro";
import DatePicker from "../../../components/DatePicker.astro";
import Toolbar from "../../../components/Toolbar.astro";
import ViewToggle from "../../../components/ViewToggle.astro";
import SortDropdown from "../../../components/SortDropdown.astro";
import RepoCardList from "../../../components/RepoCardList.astro";
import ErrorFallback from "../../../components/ErrorFallback.astro";
import { ArchiveValidationError, createArchiveService } from "../../../lib/archive-service";
import { formatWeekRange, getMondayOfWeek } from "../../../lib/dates";
import { logError } from "../../../lib/log";
import type {
	DateRepoCount,
	LanguageDistribution,
	WeeklyTrendingRepo,
} from "../../../lib/trending";
import { parseSortParam, sortWeeklyRepos } from "../../../lib/sort";
import { paginate, parsePageParam } from "../../../lib/pagination";
import Pagination from "../../../components/Pagination.astro";
import ArchiveInsights from "../../../components/ArchiveInsights.astro";
import { archivePeriodHref, getAdjacentArchivePeriods } from "../../../lib/archive-navigation";

export const prerender = false;

const requestedDate = Astro.params.date;
const archive = createArchiveService(Astro.locals.runtime.env);
let date: string;

try {
	date = archive.validateDate(requestedDate);
} catch (error) {
	if (!(error instanceof ArchiveValidationError)) throw error;
	return Astro.rewrite("/404");
}

const monday = getMondayOfWeek(date);

// Redirect to the canonical Monday URL if the date isn't already a Monday
if (date !== monday) {
	return Astro.redirect(`/trending/week/${monday}`, 302);
}

const weekLabel = formatWeekRange(date);
const sort = parseSortParam(Astro.url.searchParams.get("sort"));

let allRepos: WeeklyTrendingRepo[] = [];
let languages: LanguageDistribution[] = [];
let dateCounts: DateRepoCount[] = [];
let partial = false;
let hasError = false;
try {
	const data = await archive.getWeeklyArchive(monday);
	allRepos = sortWeeklyRepos(data.repos, sort);
	partial = data.partial;
	languages = data.languages;
	dateCounts = data.dateCounts;
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("trending_week_ssr_error", { date })(error);
}

// Paginate the sorted repos
const page = parsePageParam(Astro.url.searchParams.get("page"));
const paginationInfo = paginate(allRepos.length, page);
const repos = allRepos.slice(paginationInfo.startIndex, paginationInfo.endIndex);
const { periods, previous } = getAdjacentArchivePeriods(
	dateCounts.map(({ date: availableDate }) => availableDate),
	monday,
	"weekly",
);
const latestWeek = periods[periods.length - 1];
const emptyActions: Array<{ href: string; label: string; primary?: boolean }> = [];
if (!hasError && allRepos.length === 0) {
	if (previous && previous !== latestWeek) {
		emptyActions.push({
			href: archivePeriodHref(previous, "weekly"),
			label: "Previous available week",
		});
	}
	if (latestWeek) {
		emptyActions.push({
			href: archivePeriodHref(latestWeek, "weekly"),
			label: "View latest weekly rollup",
			primary: true,
		});
	}
}
---

<Layout
	title={`Trending ${weekLabel} — RepoTrend`}
	description={`Weekly GitHub trending repositories for ${weekLabel}. Browse the most popular open-source projects from the week of ${weekLabel}.`}
>
	<header class="weekly-heading">
		<p class="weekly-kicker">Weekly GitHub rollup</p>
		<div class="weekly-title-row">
			<h1>GitHub Trending — <time datetime={monday}>{weekLabel}</time></h1>
			{partial && (
				<span class="partial-badge" title="Data does not span the full 7 days for this week">
					Partial week
				</span>
			)}
		</div>
		<p class="weekly-context">Repositories ranked across snapshots captured during this week.</p>
	</header>
	<Toolbar>
		<DatePicker
			selectedDate={date}
			viewMode="weekly"
			availableDates={dateCounts.length > 0 ? dateCounts.map(({ date }) => date) : undefined}
		/>
		<ViewToggle activeView="weekly" currentDate={date} />
		<SortDropdown activeSort={sort} viewMode="weekly" />
	</Toolbar>
	{hasError ? <ErrorFallback /> : (
		<>
			<RepoCardList
				viewMode="weekly"
				repos={repos}
				rankOffset={paginationInfo.startIndex}
				emptyMessage={`No GitHub Trending snapshots were captured for ${weekLabel}. Choose another week to browse the archive.`}
				emptyActions={emptyActions}
			/>
			<Pagination pagination={paginationInfo} />
		</>
	)}
	<ArchiveInsights
		languages={languages}
		dateCounts={dateCounts}
		selectedDate={date}
		viewMode="weekly"
	/>
</Layout>

<style>
	.weekly-heading {
		margin-bottom: 1rem;
	}

	.weekly-kicker,
	.weekly-heading h1,
	.weekly-context {
		margin: 0;
	}

	.weekly-kicker {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.weekly-title-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
	}

	.weekly-heading h1 {
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.weekly-context {
		margin-top: 0.25rem;
		color: var(--color-text-secondary);
		font-size: 0.875rem;
	}

	.partial-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.125rem 0.5rem;
		color: var(--color-stars-today);
		background-color: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		font-size: 0.75rem;
		font-weight: 500;
		white-space: nowrap;
	}
</style>

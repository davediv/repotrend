---
import ErrorFallback from "../../components/ErrorFallback.astro";
import Layout from "../../layouts/Layout.astro";
import { createArchiveService } from "../../lib/archive-service";
import { formatDateDisplay, getMondayOfWeek } from "../../lib/dates";
import { logError } from "../../lib/log";
import type { DateRepoCount } from "../../lib/trending";

export const prerender = false;

let snapshots: DateRepoCount[] = [];
let hasError = false;

try {
	snapshots = (await createArchiveService(Astro.locals.runtime.env).getArchiveIndex()).snapshots;
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("archive_hub_ssr_error")(error);
}

const recentSnapshots = snapshots.slice(-12).reverse();
const latestSnapshot = recentSnapshots[0] ?? null;
const latestWeek = latestSnapshot ? getMondayOfWeek(latestSnapshot.date) : null;
---

<Layout
	title="GitHub Trending Archive — RepoTrend"
	description="Browse RepoTrend's daily GitHub Trending snapshots and weekly rollups."
>
	<header class="archive-heading">
		<p class="archive-kicker">GitHub Trending history</p>
		<h1>Archive</h1>
		<p>Browse captured daily snapshots or explore a weekly rollup.</p>
	</header>

	{hasError ? (
		<ErrorFallback />
	) : latestSnapshot ? (
		<>
			<nav class="archive-modes" aria-label="Archive views">
				<a class="archive-mode" href={`/trending/${latestSnapshot.date}`}>
					<strong>Latest daily snapshot</strong>
					<span>{formatDateDisplay(latestSnapshot.date)}</span>
				</a>
				{latestWeek && (
					<a class="archive-mode" href={`/trending/week/${latestWeek}`}>
						<strong>Weekly rollups</strong>
						<span>Explore trends across a full week</span>
					</a>
				)}
			</nav>

			<section class="recent-archive" aria-labelledby="recent-snapshots-heading">
				<div class="section-heading">
					<h2 id="recent-snapshots-heading">Recent snapshots</h2>
					<p>{snapshots.length} captured {snapshots.length === 1 ? "day" : "days"}</p>
				</div>
				<ul class="snapshot-list">
					{recentSnapshots.map((snapshot) => (
						<li>
							<a href={`/trending/${snapshot.date}`}>
								<time datetime={snapshot.date}>{formatDateDisplay(snapshot.date)}</time>
								<span>{snapshot.count} repositories</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</>
	) : (
		<div class="archive-empty" role="status">
			<h2>No snapshots yet</h2>
			<p>The archive will appear here after the first GitHub Trending capture.</p>
		</div>
	)}
</Layout>

<style>
	.archive-heading {
		max-width: 44rem;
		margin-bottom: 1.5rem;
	}

	.archive-kicker,
	.archive-heading h1,
	.archive-heading p {
		margin: 0;
	}

	.archive-kicker {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.archive-heading h1 {
		font-size: 2rem;
		line-height: 1.25;
	}

	.archive-heading > p:last-child {
		margin-top: 0.375rem;
		color: var(--color-text-secondary);
	}

	.archive-modes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.archive-mode {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 88px;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-bg);
		color: var(--color-text);
		text-decoration: none;
	}

	.archive-mode:hover {
		border-color: var(--color-border-hover);
		background: var(--color-bg-secondary);
	}

	.archive-mode span {
		color: var(--color-text-secondary);
		font-size: 0.875rem;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.section-heading h2,
	.section-heading p {
		margin: 0;
	}

	.section-heading h2 {
		font-size: 1.25rem;
	}

	.section-heading p {
		color: var(--color-text-secondary);
		font-size: 0.8125rem;
	}

	.snapshot-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.snapshot-list a {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 64px;
		padding: 0.625rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-link);
		text-decoration: none;
	}

	.snapshot-list a:hover {
		border-color: var(--color-border-hover);
		background: var(--color-bg-secondary);
	}

	.snapshot-list span {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
	}

	.archive-empty {
		padding: 3rem 1rem;
		text-align: center;
	}

	.archive-empty h2,
	.archive-empty p {
		margin: 0;
	}

	.archive-empty p {
		margin-top: 0.375rem;
		color: var(--color-text-secondary);
	}

	@media (max-width: 640px) {
		.archive-modes,
		.snapshot-list {
			grid-template-columns: 1fr;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.125rem;
		}
	}
</style>

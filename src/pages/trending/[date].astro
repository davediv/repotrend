---
import Layout from "../../layouts/Layout.astro";
import DatePicker from "../../components/DatePicker.astro";
import Toolbar from "../../components/Toolbar.astro";
import RepoCardList from "../../components/RepoCardList.astro";
import ErrorFallback from "../../components/ErrorFallback.astro";
import { formatDateDisplay, isValidBrowseDate } from "../../lib/dates";
import { logError } from "../../lib/log";
import {
	getDateRepoCounts,
	getLanguageDistribution,
	getTrendingRepos,
	type DateRepoCount,
	type LanguageDistribution,
	type TrendingRepo,
} from "../../lib/trending";
import LanguageChart from "../../components/LanguageChart.astro";
import CalendarHeatmap from "../../components/CalendarHeatmap.astro";

export const prerender = false;

const { date } = Astro.params;

if (!date || !isValidBrowseDate(date)) {
	return Astro.rewrite("/404");
}

const displayDate = formatDateDisplay(date);

let repos: TrendingRepo[] = [];
let languages: LanguageDistribution[] = [];
let dateCounts: DateRepoCount[] = [];
let hasError = false;
try {
	const db = Astro.locals.runtime.env.DB;
	const [trendingRepos, languageResult, dateCountResult] = await Promise.all([
		getTrendingRepos(db, date),
		getLanguageDistribution(db, date).catch(() => []),
		getDateRepoCounts(db).catch(() => []),
	]);
	repos = trendingRepos;
	languages = languageResult;
	dateCounts = dateCountResult;
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("trending_date_ssr_error", { date })(error);
}
---

<Layout
	title={`Trending ${displayDate} — RepoTrend`}
	description={`GitHub trending repositories for ${displayDate}. Browse the most popular open-source projects that trended on ${displayDate}.`}
>
	<Toolbar>
		<DatePicker
			selectedDate={date}
			viewMode="daily"
			availableDates={dateCounts.length > 0 ? dateCounts.map(({ date }) => date) : undefined}
		/>
	</Toolbar>
	<LanguageChart languages={languages} />
	<CalendarHeatmap dateCounts={dateCounts} selectedDate={date} />
	{hasError ? (
		<ErrorFallback />
	) : (
		<RepoCardList
			repos={repos}
			emptyMessage={`No GitHub Trending snapshot was captured for ${displayDate}. Choose another date to browse the archive.`}
		/>
	)}
</Layout>

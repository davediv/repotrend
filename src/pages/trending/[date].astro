---
import DailyArchivePage from "../../components/DailyArchivePage.astro";
import {
	ArchiveValidationError,
	createArchiveService,
	dailyArchiveCacheControl,
} from "../../lib/archive-service";
import type { DailyArchiveData } from "../../lib/daily-archive";
import { todayUTC } from "../../lib/dates";
import { logError } from "../../lib/log";

export const prerender = false;

const requestedDate = Astro.params.date;
const archive = createArchiveService(Astro.locals.runtime.env);
let date: string;

try {
	date = archive.validateDate(requestedDate);
} catch (error) {
	if (!(error instanceof ArchiveValidationError)) throw error;
	return Astro.rewrite("/404");
}

const today = todayUTC();
if (date === today) {
	return Astro.redirect("/", 302);
}

let data: DailyArchiveData = {
	selectedDate: date,
	snapshot: null,
	repos: [],
	languages: [],
	dateCounts: [],
	support: { languages: "ready", dateIndex: "ready" },
};
let hasError = false;

try {
	data = await archive.getDailyArchive({ mode: "exact", date });
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("trending_date_ssr_error", { date })(error);
}

Astro.response.headers.set(
	"Cache-Control",
	hasError ? "no-store" : dailyArchiveCacheControl(date, today),
);
---

<DailyArchivePage data={data} today={today} context="archive" hasError={hasError} />

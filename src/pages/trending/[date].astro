---
import DailyArchivePage from "../../components/DailyArchivePage.astro";
import { loadDailyArchive, type DailyArchiveData } from "../../lib/daily-archive";
import { isValidBrowseDate, todayUTC } from "../../lib/dates";
import { logError } from "../../lib/log";

export const prerender = false;

const { date } = Astro.params;

if (!date || !isValidBrowseDate(date)) {
	return Astro.rewrite("/404");
}

const today = todayUTC();
if (date === today) {
	return Astro.redirect("/", 302);
}

let data: DailyArchiveData = {
	selectedDate: date,
	snapshot: null,
	repos: [],
	languages: [],
	dateCounts: [],
};
let hasError = false;

try {
	data = await loadDailyArchive(Astro.locals.runtime.env.DB, { mode: "exact", date });
} catch (error) {
	hasError = true;
	Astro.response.status = 500;
	Astro.response.statusText = "Internal Server Error";
	logError("trending_date_ssr_error", { date })(error);
}
---

<DailyArchivePage data={data} today={today} context="archive" hasError={hasError} />

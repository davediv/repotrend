---
import type { DateRepoCount } from "../lib/trending";

interface Props {
	/** Repo counts per date, sorted chronologically (oldest first). */
	dateCounts: DateRepoCount[];
	/** Currently viewed date or week, highlighted in the heatmap. */
	selectedDate?: string;
	/** Preserve daily or weekly archive context in every link. */
	viewMode?: "daily" | "weekly";
}

const { dateCounts, selectedDate, viewMode = "daily" } = Astro.props;

if (dateCounts.length === 0) return;
---

<details
	class="calendar-heatmap"
	data-date-counts={JSON.stringify(dateCounts)}
	data-selected-date={selectedDate}
	data-view-mode={viewMode}
>
	<summary>
		<span>Activity heatmap</span>
		<span class="heatmap-summary-meta">Optional visual overview</span>
	</summary>
	<div class="heatmap-content">
		<p class="heatmap-help">
			Each square represents a captured day. Use the available {viewMode === "weekly" ? "weeks" : "dates"} list above for larger navigation targets.
		</p>
		<div class="heatmap-visualization" aria-live="polite">
			<p class="heatmap-loading">Loading activity heatmap…</p>
			<noscript>
				<p class="heatmap-fallback">JavaScript is required for this optional visualization. The available periods list above remains fully usable.</p>
			</noscript>
		</div>
	</div>
</details>

<script>
	for (const heatmap of document.querySelectorAll<HTMLDetailsElement>(
		".calendar-heatmap:not([data-loader-ready])",
	)) {
		heatmap.dataset.loaderReady = "true";
		heatmap.addEventListener(
			"toggle",
			async () => {
				if (!heatmap.open) return;

				try {
					const { renderCalendarHeatmap } = await import("../scripts/calendar-heatmap");
					renderCalendarHeatmap(heatmap);
				} catch (error) {
					console.error("Unable to render the archive activity heatmap", error);
					const visualization = heatmap.querySelector<HTMLElement>(".heatmap-visualization");
					if (visualization) {
						const message = document.createElement("p");
						message.className = "heatmap-fallback";
						message.textContent =
							"The activity heatmap could not be loaded. Use the available periods list above.";
						visualization.replaceChildren(message);
					}
				}
			},
			{ once: true },
		);
	}
</script>

<style is:global>
	.calendar-heatmap {
		--cell-size: 24px;
		--cell-gap: 4px;
		margin: 0;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background-color: var(--color-bg-secondary);
	}

	.calendar-heatmap > summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 44px;
		padding: 0.5rem 1rem;
		color: var(--color-text);
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}

	.calendar-heatmap .heatmap-summary-meta {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 400;
	}

	.calendar-heatmap .heatmap-content {
		padding: 1rem;
		border-top: 1px solid var(--color-border);
	}

	.calendar-heatmap .heatmap-help,
	.calendar-heatmap .heatmap-loading,
	.calendar-heatmap .heatmap-fallback {
		margin: 0 0 0.75rem;
		color: var(--color-text-secondary);
		font-size: 0.8125rem;
	}

	.calendar-heatmap .heatmap-loading,
	.calendar-heatmap .heatmap-fallback {
		margin-bottom: 0;
	}

	.calendar-heatmap .heatmap-body {
		display: flex;
		gap: 4px;
	}

	.calendar-heatmap .dow-labels {
		display: grid;
		grid-template-rows: repeat(7, var(--cell-size));
		gap: var(--cell-gap);
		padding-top: 20px;
	}

	.calendar-heatmap .dow-label {
		padding-right: 4px;
		color: var(--color-text-secondary);
		font-size: 0.6875rem;
		line-height: var(--cell-size);
		text-align: right;
	}

	.calendar-heatmap .heatmap-scroll {
		flex: 1;
		min-width: 0;
		overflow-x: auto;
	}

	.calendar-heatmap .month-row {
		display: grid;
		gap: 0 var(--cell-gap);
		height: 16px;
		margin-bottom: 4px;
	}

	.calendar-heatmap .month-label {
		color: var(--color-text-secondary);
		font-size: 0.6875rem;
		line-height: 16px;
		white-space: nowrap;
	}

	.calendar-heatmap .cell-grid {
		display: grid;
		grid-template-rows: repeat(7, var(--cell-size));
		grid-auto-flow: column;
		grid-auto-columns: var(--cell-size);
		gap: var(--cell-gap);
	}

	.calendar-heatmap .heatmap-cell,
	.calendar-heatmap .legend-cell {
		display: block;
		width: var(--cell-size);
		height: var(--cell-size);
		border-radius: 3px;
	}

	.calendar-heatmap .level-0 {
		background-color: var(--color-heatmap-empty);
	}

	.calendar-heatmap .level-1 {
		background-color: var(--color-heatmap-l1);
	}

	.calendar-heatmap .level-2 {
		background-color: var(--color-heatmap-l2);
	}

	.calendar-heatmap .level-3 {
		background-color: var(--color-heatmap-l3);
	}

	.calendar-heatmap .level-4 {
		background-color: var(--color-heatmap-l4);
	}

	.calendar-heatmap a.heatmap-cell {
		cursor: pointer;
		text-decoration: none;
	}

	.calendar-heatmap a.heatmap-cell:hover,
	.calendar-heatmap a.heatmap-cell:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: -2px;
	}

	.calendar-heatmap .heatmap-cell.selected {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
	}

	.calendar-heatmap .heatmap-legend {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 3px;
		margin-top: 0.75rem;
	}

	.calendar-heatmap .legend-text {
		margin: 0 2px;
		color: var(--color-text-secondary);
		font-size: 0.6875rem;
	}

	.calendar-heatmap .legend-cell {
		--cell-size: 12px;
		display: inline-block;
	}

	@media (max-width: 640px) {
		.calendar-heatmap > summary,
		.calendar-heatmap .heatmap-content {
			padding-right: 0.75rem;
			padding-left: 0.75rem;
		}

		.calendar-heatmap .dow-labels {
			display: none;
		}
	}
</style>

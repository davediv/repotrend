---
import type { TrendingRepo, WeeklyTrendingRepo } from "../lib/trending";
// Server-rendered repo card list. Repos are fetched during SSR and passed as props,
// eliminating the client-side fetch that previously delayed LCP and caused CLS.
// Shared styles live in src/styles/repo-card.css (imported globally via Layout.astro).
import RepoCard from "./RepoCard.astro";

interface Props {
	viewMode?: "daily" | "weekly";
	repos: TrendingRepo[] | WeeklyTrendingRepo[];
	/** Offset for rank numbering when paginated (0-based index of first item). */
	rankOffset?: number;
	/** Empty-state copy for contexts such as today's not-yet-scraped snapshot. */
	emptyMessage?: string;
	/** Recovery links shown when no repositories are available. */
	emptyActions?: Array<{ href: string; label: string; primary?: boolean }>;
}

const {
	viewMode = "daily",
	repos,
	rankOffset = 0,
	emptyMessage: emptyMessageOverride,
	emptyActions = [],
} = Astro.props;
const isWeekly = viewMode === "weekly";
const emptyMessage =
	emptyMessageOverride ??
	(isWeekly
		? "No trending data available for this week."
		: "No trending data available for this date.");
---

{repos.length > 0 ? (
	<>
		<svg class="repo-icon-sprite" aria-hidden="true" focusable="false">
			<symbol id="repo-icon-star" viewBox="0 0 24 24">
				<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
			</symbol>
			<symbol id="repo-icon-fork" viewBox="0 0 24 24">
				<circle cx="12" cy="18" r="3"></circle>
				<circle cx="6" cy="6" r="3"></circle>
				<circle cx="18" cy="6" r="3"></circle>
				<path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"></path>
				<path d="M12 12v3"></path>
			</symbol>
			<symbol id="repo-icon-calendar" viewBox="0 0 24 24">
				<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
				<line x1="16" y1="2" x2="16" y2="6"></line>
				<line x1="8" y1="2" x2="8" y2="6"></line>
				<line x1="3" y1="10" x2="21" y2="10"></line>
			</symbol>
		</svg>
		<ol id="results" class="card-list-results" aria-label={isWeekly ? "Weekly trending repositories" : "Trending repositories"}>
			{repos.map((repo, i) => (
				<li>
					<RepoCard
						rank={rankOffset + i + 1}
						repoOwner={repo.repo_owner}
						repoName={repo.repo_name}
						description={repo.description}
						language={repo.language}
						languageColor={repo.language_color}
						topics={repo.topics}
						totalStars={repo.total_stars}
						forks={repo.forks}
						starsToday={isWeekly ? (repo as WeeklyTrendingRepo).total_stars_gained : (repo as TrendingRepo).stars_today}
						viewMode={viewMode}
						appearances={isWeekly ? (repo as WeeklyTrendingRepo).appearances : undefined}
					/>
				</li>
			))}
		</ol>
	</>
) : (
	<div
		class="card-list-empty"
		data-analytics-view="empty_state_view"
		data-analytics-surface={`${viewMode}_archive`}
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
			<polyline points="14 2 14 8 20 8"></polyline>
			<line x1="9" y1="15" x2="15" y2="15"></line>
		</svg>
		<p role="status">{emptyMessage}</p>
		{emptyActions.length > 0 && (
			<div class="empty-actions">
				{emptyActions.map((action) => (
					<a href={action.href} class:list={["empty-action", { primary: action.primary }]}>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>
)}

<style>
	.repo-icon-sprite {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}

	.card-list-results {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Empty state */
	.card-list-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		padding: 3rem 1rem;
		color: var(--color-text-secondary);
		text-align: center;
	}

	.card-list-empty p {
		margin: 0;
		font-size: 1rem;
	}

	.empty-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.empty-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.625rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-text);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}

	.empty-action:hover {
		border-color: var(--color-border-hover);
		background: var(--color-bg-secondary);
	}

	.empty-action.primary {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-accent-text);
	}
</style>

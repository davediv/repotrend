---
// Server-rendered repo card list. Repos are fetched during SSR and passed as props,
// eliminating the client-side fetch that previously delayed LCP and caused CLS.
// Shared styles live in src/styles/repo-card.css (imported globally via Layout.astro).
import RepoCard from "./RepoCard.astro";
import type { TrendingRepo, WeeklyTrendingRepo } from "../lib/trending";

interface Props {
	viewMode?: "daily" | "weekly";
	repos: TrendingRepo[] | WeeklyTrendingRepo[];
	/** Offset for rank numbering when paginated (0-based index of first item). */
	rankOffset?: number;
	/** Empty-state copy for contexts such as today's not-yet-scraped snapshot. */
	emptyMessage?: string;
	/** Recovery links shown when no repositories are available. */
	emptyActions?: Array<{ href: string; label: string; primary?: boolean }>;
}

const {
	viewMode = "daily",
	repos,
	rankOffset = 0,
	emptyMessage: emptyMessageOverride,
	emptyActions = [],
} = Astro.props;
const isWeekly = viewMode === "weekly";
const emptyMessage =
	emptyMessageOverride ??
	(isWeekly
		? "No trending data available for this week."
		: "No trending data available for this date.");
---

{repos.length > 0 ? (
	<ol id="results" class="card-list-results" aria-label={isWeekly ? "Weekly trending repositories" : "Trending repositories"}>
		{repos.map((repo, i) => (
			<li>
				<RepoCard
					rank={rankOffset + i + 1}
					repoOwner={repo.repo_owner}
					repoName={repo.repo_name}
					description={repo.description}
					language={repo.language}
					languageColor={repo.language_color}
					topics={repo.topics}
					totalStars={repo.total_stars}
					forks={repo.forks}
					starsToday={isWeekly ? (repo as WeeklyTrendingRepo).total_stars_gained : (repo as TrendingRepo).stars_today}
					viewMode={viewMode}
					appearances={isWeekly ? (repo as WeeklyTrendingRepo).appearances : undefined}
				/>
			</li>
		))}
	</ol>
) : (
	<div
		class="card-list-empty"
		data-analytics-view="empty_state_view"
		data-analytics-surface={`${viewMode}_archive`}
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
			<polyline points="14 2 14 8 20 8"></polyline>
			<line x1="9" y1="15" x2="15" y2="15"></line>
		</svg>
		<p role="status">{emptyMessage}</p>
		{emptyActions.length > 0 && (
			<div class="empty-actions">
				{emptyActions.map((action) => (
					<a href={action.href} class:list={["empty-action", { primary: action.primary }]}>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>
)}

<style>
	.card-list-results {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Empty state */
	.card-list-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		padding: 3rem 1rem;
		color: var(--color-text-secondary);
		text-align: center;
	}

	.card-list-empty p {
		margin: 0;
		font-size: 1rem;
	}

	.empty-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.empty-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.625rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-text);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}

	.empty-action:hover {
		border-color: var(--color-border-hover);
		background: var(--color-bg-secondary);
	}

	.empty-action.primary {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-accent-text);
	}
</style>

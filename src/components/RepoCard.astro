---
// Server-side repo card used for SSR rendering.
// Shared styles live in src/styles/repo-card.css (imported globally via Layout.astro).
import { formatNumber, sanitizeHexColor } from "../lib/format";
import { githubRepositoryUrl, repositoryPath } from "../lib/repository";

interface Props {
	rank: number;
	repoOwner: string;
	repoName: string;
	description: string | null;
	language: string | null;
	languageColor: string | null;
	topics?: string[];
	totalStars: number;
	forks: number;
	starsToday: number;
	viewMode?: "daily" | "weekly";
	/** Number of days this repo appeared on trending this week (weekly view only). */
	appearances?: number;
}

const {
	rank,
	repoOwner,
	repoName,
	description,
	language,
	languageColor,
	topics = [],
	totalStars,
	forks,
	starsToday,
	viewMode = "daily",
	appearances,
} = Astro.props;

const detailUrl = repositoryPath(repoOwner, repoName);
const githubUrl = githubRepositoryUrl(repoOwner, repoName);
const safeColor = sanitizeHexColor(languageColor);
const headingId = `repo-heading-${rank}`;
const starsLabel = viewMode === "weekly" ? "this week" : "today";
const appearanceLabel = appearances === 1 ? "1 day" : `${appearances} days`;
const visibleTopics = topics.slice(0, 6);
const hiddenTopicCount = topics.length - visibleTopics.length;
---

<article class="repo-card" aria-labelledby={headingId}>
	<div class="repo-rank" aria-hidden="true">{rank}</div>
	<div class="repo-content">
		<div class="repo-title-row">
			<h2 class="repo-name" id={headingId}>
				<span class="sr-only">#{rank}</span>
				<a href={detailUrl} aria-label={`${repoOwner}/${repoName}`}>
					<span class="repo-owner">{repoOwner}</span>
					<span class="repo-separator">/</span>
					<span class="repo-name-text">{repoName}</span>
				</a>
			</h2>
			{appearances != null && (
				<span class="appearances-badge" title={`Appeared on GitHub Trending for ${appearanceLabel} this week`}>
					<svg class="repo-card-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
						<use href="#repo-icon-calendar"></use>
					</svg>
					<span class="sr-only">Trending for </span>
					{appearanceLabel}
				</span>
			)}
		</div>

		{description && <p class="repo-description">{description}</p>}
		{visibleTopics.length > 0 && (
			<ul class="repo-topics" aria-label="Repository topics">
				{
					visibleTopics.map((topic) => (
						<li>
							<a class="topic-tag" href={`/search?topic=${encodeURIComponent(topic)}`}>
								#{topic}
							</a>
						</li>
					))
				}
				{hiddenTopicCount > 0 && (
					<li>
						<span class="topic-more" title={`${hiddenTopicCount} more topics not shown`}>
							+{hiddenTopicCount}
						</span>
					</li>
				)}
			</ul>
		)}

		<div class="repo-meta">
			{language && (
				<span class="meta-item language">
					<span class="language-dot" aria-hidden="true" style={safeColor ? `background-color: ${safeColor}` : undefined}></span>
					{language}
				</span>
			)}

			<span class="meta-item">
				<svg class="repo-card-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
					<use href="#repo-icon-star"></use>
				</svg>
				<span class="sr-only">Total stars:</span>
				{formatNumber(totalStars)}
			</span>

			<span class="meta-item">
				<svg class="repo-card-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
					<use href="#repo-icon-fork"></use>
				</svg>
				<span class="sr-only">Forks:</span>
				{formatNumber(forks)}
			</span>

			<span class="meta-item stars-today">
				<svg class="repo-card-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
					<use href="#repo-icon-star"></use>
				</svg>
				<span class="sr-only">Stars gained </span>
				{formatNumber(starsToday)} {starsLabel}
			</span>

			<a
				class="repo-github-link"
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				data-analytics-surface="snapshot_card"
			>
				GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in new tab)</span>
			</a>
		</div>
	</div>
</article>
